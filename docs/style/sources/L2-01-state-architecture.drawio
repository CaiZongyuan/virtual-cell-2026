        <mxCell id="b_hbb" value="" style="rounded=0;html=1;perimeter=rectanglePerimeter;fillColor=#000000;strokeColor=none;" vertex="1" parent="bf"><mxGeometry x="825" y="411" width="36" height="3" as="geometry"/></mxCell>
        <mxCell id="b_hbv" value="" style="rounded=0;html=1;perimeter=rectanglePerimeter;fillColor=#000000;strokeColor=none;" vertex="1" parent="bf"><mxGeometry x="861" y="318" width="3" height="96" as="geometry"/></mxCell>
        <mxCell id="b_hbl" value="h = 12&#xa;个头" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#111111;" vertex="1" parent="bf"><mxGeometry x="872" y="336" width="70" height="56" as="geometry"/></mxCell>
