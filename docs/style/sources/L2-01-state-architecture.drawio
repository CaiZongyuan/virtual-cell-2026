        <mxCell id="b_note" value="V、K、Q 都来自同一批细胞 token —— 这是自注意力。&#xa;State 用双向注意力，且不使用旋转位置编码（RoPE）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="bf"><mxGeometry x="24" y="586" width="912" height="46" as="geometry"/></mxCell>
