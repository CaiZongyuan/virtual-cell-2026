        <mxCell id="eb6" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.74;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="bf" source="b_lq" target="b_bus1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb7" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="bf" source="b_bus1" target="b_h1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb8" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="bf" source="b_bus1" target="b_h2"><mxGeometry relative="1" as="geometry"/></mxCell>
