        <mxCell id="eb10" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="bf" source="b_h2" target="b_bus2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb11" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="bf" source="b_bus2" target="b_concat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb12" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="bf" source="b_concat" target="b_lin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb13" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="bf" source="b_lin" target="b_out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b_cap" value="（b）每个细胞是一个 token，token 之间两两算注意力（cell_set_len = 64）。&#xa;一个 token 是一条基因表达向量，所以「集合长度 64」指 64 个细胞，不是 64 个基因。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="800" y="846" width="960" height="48" as="geometry"/></mxCell>
        <mxCell id="cf" value="" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;dashed=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="800" y="906" width="960" height="610" as="geometry"/></mxCell>
        <mxCell id="c_t" value="（c）Energy 距离集合损失：比较两个集合的分布，不要求逐细胞配对" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#111111;fontStyle=1;" vertex="1" parent="cf"><mxGeometry x="24" y="22" width="912" height="26" as="geometry"/></mxCell>
        <mxCell id="c_note" value="这是 State 相对普通回归基线的关键差别：损失在集合层面比较分布，&#xa;模型不必猜「哪个真实细胞对应哪个预测细胞」，两边的集合大小也不必相等。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="cf"><mxGeometry x="24" y="56" width="912" height="50" as="geometry"/></mxCell>
        <mxCell id="c_out" value="对集合整体给出一个标量 → 反向传播" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#333333;" vertex="1" parent="cf"><mxGeometry x="225" y="112" width="510" height="28" as="geometry"/></mxCell>
        <mxCell id="c_green" value="标量损失（仅训练时存在）" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="285" y="168" width="390" height="54" as="geometry"/></mxCell>
        <mxCell id="c_energy" value="Energy 距离（分布级损失）&#xa;2·E‖P−Q‖ − E‖P−P′‖ − E‖Q−Q′‖&#xa;（标准形式；源码配置 loss=energy）" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="85" y="254" width="790" height="84" as="geometry"/></mxCell>
        <mxCell id="c_dist" value="两两距离 ‖ŷ − x′‖（集合级，不配对）" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="85" y="370" width="790" height="54" as="geometry"/></mxCell>
        <mxCell id="c_setP" value="预测集合（模型输出）" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="85" y="454" width="360" height="58" as="geometry"/></mxCell>
        <mxCell id="c_setQ" value="真实集合（公共训练数据）" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="515" y="454" width="360" height="58" as="geometry"/></mxCell>
        <mxCell id="c_labP" value="预测细胞集合&#xa;{ŷ₁ … ŷ₆₄}" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="cf"><mxGeometry x="85" y="540" width="360" height="46" as="geometry"/></mxCell>
        <mxCell id="c_labQ" value="真实细胞集合&#xa;{x′₁ … x′₆₄}" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="cf"><mxGeometry x="515" y="540" width="360" height="46" as="geometry"/></mxCell>
        <mxCell id="ec1" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="cf" source="c_labP" target="c_setP"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec2" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="cf" source="c_labQ" target="c_setQ"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec3" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2278;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="cf" source="c_setP" target="c_dist"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec4" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7722;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="cf" source="c_setQ" target="c_dist"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec5" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="cf" source="c_dist" target="c_energy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec6" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="cf" source="c_energy" target="c_green"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec7" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="cf" source="c_green" target="c_out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c_cap" value="（c）损失类型来自官方配置 loss=energy / distributional_loss=energy。&#xa;图中画的是标准 Energy 距离的三项结构，用来说明损失比较的是分布；未逐行复刻官方实现。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="800" y="1536" width="960" height="48" as="geometry"/></mxCell>
