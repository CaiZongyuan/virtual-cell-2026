="" style="rounded=0;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pb"><mxGeometry x="130" y="280" width="15.0208" height="22" as="geometry"/></mxCell><mxCell id="b_et2" value="细胞间 2.0 MB (39.1×)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#111111;" vertex="1" parent="pb"><mxGeometry x="151.021" y="280" width="186" height="22" as="geometry"/></mxCell><mxCell id="b_n3" value="K = 512" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#111111;" vertex="1" parent="pb"><mxGeometry x="30" y="324" width="96" height="46" as="geometry"/></mxCell><mxCell id="b_i3" value="" style="rounded=0;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pb"><mxGeometry x="130" y="324" width="132.745" height="22" as="geometry"/></mxCell><mxCell id="b_it3" value="细胞内 156.2 MB" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#8a4b00;" vertex="1" parent="pb"><mxGeometry x="268.745" y="324" width="186" height="22" as="geometry"/></mxCell><mxCell id="b_e3" value="" style="rounded=0;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pb"><mxGeometry x="130" y="348" width="30.0416" height="22" as="geometry"/></mxCell><mxCell id="b_et3" value="细胞间 8.0 MB (19.5×)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#111111;" vertex="1" parent="pb"><mxGeometry x="166.042" y="348" width="186" height="22" as="geometry"/></mxCell><mxCell id="b_n4" value="K = 1024" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#111111;" vertex="1" parent="pb"><mxGeometry x="30" y="392" width="96" height="46" as="geometry"/></mxCell><mxCell id="b_i4" value="" style="rounded=0;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pb"><mxGeometry x="130" y="392" width="187.76" height="22" as="geometry"/></mxCell><mxCell id="b_it4" value="细胞内 312.5 MB" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#8a4b00;" vertex="1" parent="pb"><mxGeometry x="323.76" y="392" width="186" height="22" as="geometry"/></mxCell><mxCell id="b_e4" value="" style="rounded=0;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pb"><mxGeometry x="130" y="416" width="60.0833" height="22" as="geometry"/></mxCell><mxCell id="b_et4" value="细胞间 32.0 MB (9.8×)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#111111;" vertex="1" parent="pb"><mxGeometry x="196.083" y="416" width="186" height="22" as="geometry"/></mxCell><mxCell id="b_axis" value="柱长按 √(MB/320) 压缩；数值以标签为准" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" vertex="1" parent="pb"><mxGeometry x="130" y="96" width="300" height="20" as="geometry"/></mxCell><mxCell id="b_punch" value="" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pb"><mxGeometry x="30" y="486" width="460" height="130" as="geometry"/></mxCell><mxCell id="b_pt" value="K = 512 时，细胞内注意力是细胞间的 &lt;b&gt;19.5 倍&lt;/b&gt;。&#xa;因为细胞内要跑 B·K 条序列（每个细胞一次），&#xa;细胞间只跑 B 条。倍数随 K 增大而下降：&#xa;K = 64 时 156.2×，K = 1024 时 9.8×。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1f4d13;" vertex="1" parent="b_punch"><mxGeometry x="20" y="16" width="420" height="98" as="geometry"/></mxCell><mxCell id="b_mem" value="" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pb"><mxGeometry x="30" y="646" width="460" height="200" as="geometry"/></mxCell><mxCell id="b_mt" value="本机 8 GiB 能跑到哪一步（手算，非实测）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="b_mem"><mxGeometry x="20" y="14" width="420" height="24" as="geometry"/></mxCell><mxCell id="b_mb" value="单次前向，fp32，2.17 亿参数（≈830 MB）：&#xa;· K = 256 → 最大 batch &lt;b&gt;9&lt;/b&gt;（7.82 GiB），batch 10 即 8.60 GiB&#xa;· K = 512 → 最大 batch &lt;b&gt;4&lt;/b&gt;（7.18 GiB），batch 5 即 8.77 GiB&#xa;· bf16 同档：K = 256 → 19；K = 512 → 9&#xa;&#xa;后训练（batch = 8, K = 512）：权重+梯度+优化器 2.43 GiB，&#xa;注意力分数（含 autograd 保存的 softmax）&lt;b&gt;23.10 GiB&lt;/b&gt; → 远超 8 GiB。&#xa;&lt;b&gt;耗时一个数字都没有&lt;/b&gt;：FLOPs 量级给了，换算不代填。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#222222;" vertex="1" parent="b_mem"><mxGeometry x="20" y="44" width="420" height="146" as="geometry"/></mxCell><mxCell id="b_comp" value="" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pb"><mxGeometry x="30" y="872" width="460" height="180" as="geometry"/></mxCell><mxCell id="b_ct" value="算力口径：只给 FLOPs，不给秒" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#5a4a00;fontStyle=1;" vertex="1" parent="b_comp"><mxGeometry x="20" y="14" width="420" height="24" as="geometry"/></mxCell><mxCell id="b_cb" value="K = 512、batch = 1 的一次前向约 &lt;b&gt;2.4×10¹¹ FLOPs&lt;/b&gt;。&#xa;主导项是细胞间注意力的 2K²d 与 output_mlp 的 4ndG。&#xa;&#xa;换算成耗时需要「GPU 有效算力 × 达成率」两个数，&#xa;本机没跑过，&lt;b&gt;不代填&lt;/b&gt; —— 这与 L2-01 §10.3 同一口径。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#5a4a00;" vertex="1" parent="b_comp"><mxGeometry x="20" y="44" width="420" height="126" as="geometry"/></mxCell><mxCell id="b_ev" value="" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pb"><mxGeometry x="30" y="1078" width="460" height="158" as="geometry"/></mxCell><mxCell id="b_evt" value="&lt;b&gt;不是实测。&lt;/b&gt;&#xa;全部数字按张量形状手算，未实例化确认；&#xa;不含 allocator 碎片与 CUDA context 开销。&#xa;唯一一次与官方数字碰撞成功的是参数量：&#xa;Large 217,484,712 / 非嵌入 193,463,912，&#xa;与论文表 3 的 2.17 亿 / 1.93 亿一致。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#7a2222;" vertex="1" parent="b_ev"><mxGeometry x="20" y="14" width="420" height="130" as="geometry"/></mxCell><mxCell id="pc" value="" style="rounded=0;html=1;perimeter=rectanglePerimeter;fillColor=#eef3fa;strokeColor=#a9c3e0;dashed=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1294" y="130" width="506" height="1330" as="geometry"/></mxCell><mxCell id="c_t" value="（c）窗口切分：25% 是误读" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#111111;fontStyle=1;" vertex="1" parent="pc"><mxGeometry x="20" y="18" width="466" height="28" as="geometry"/></mxCell><mxCell id="c_sub" value="源码 inference.py::get_incontext_prediction 决定切分的是&#xa;&lt;b&gt;ratio = prompt_ratio + context_ratio&lt;/b&gt;（默认 0.25 + 0.4 = 0.65），&#xa;不是论文正文写的「提示 25% 固定」。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#a33;" vertex="1" parent="pc"><mxGeometry x="20" y="52" width="466" height="64" as="geometry"/></mxCell><mxCell id="c_k1" value="prompt_ratio = 0.25" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="26" y="138" width="176" height="52" as="geometry"/></mxCell><mxCell id="c_k2" value="context_ratio = 0.40" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="26" y="206" width="176" height="52" as="geometry"/></mxCell><mxCell id="c_add" value="+" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#111111;" vertex="1" parent="pc"><mxGeometry x="99" y="272" width="30" height="30" as="geometry"/></mxCell><mxCell id="c_e1" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1408" y="294" as="sourcePoint"/><mxPoint x="1408" y="417" as="targetPoint"/><Array as="points"><mxPoint x="1544" y="294"/><mxPoint x="1544" y="417"/></Array></mxGeometry></mxCell><mxCell id="c_e2" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1408" y="362" as="sourcePoint"/><mxPoint x="1408" y="417" as="targetPoint"/><Array as="points"><mxPoint x="1469" y="362"/><mxPoint x="1469" y="417"/></Array></mxGeometry></mxCell><mxCell id="c_ratio" value="ratio = 0.65" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="26" y="322" width="176" height="52" as="geometry"/></mxCell><mxCell id="c_split" value="n_test = int(K·(1−ratio)) = 179&#xa;n_base = K − n_test = 333" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#111111;" vertex="1" parent="pc"><mxGeometry x="26" y="386" width="176" height="74" as="geometry"/></mxCell><mxCell id="c_kt" value="K = 512（后训练档）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="pc"><mxGeometry x="262" y="138" width="218" height="24" as="geometry"/></mxCell><mxCell id="c_w0" value="" style="rounded=0;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="262" y="170" width="218" height="84" as="geometry"/></mxCell><mxCell id="c_wt0" value="窗口 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="c_w0"><mxGeometry x="10" y="8" width="198" height="22" as="geometry"/></mxCell><mxCell id="c_wm0" value="333 提示 + 179 查询" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#222222;" vertex="1" parent="c_w0"><mxGeometry x="10" y="30" width="198" height="20" as="geometry"/></mxCell><mxCell id="c_wr0" value="查询 0–178" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#a33;" vertex="1" parent="c_w0"><mxGeometry x="10" y="52" width="198" height="24" as="geometry"/></mxCell><mxCell id="c_w1" value="" style="rounded=0;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="262" y="270" width="218" height="84" as="geometry"/></mxCell><mxCell id="c_wt1" value="窗口 2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="c_w1"><mxGeometry x="10" y="8" width="198" height="22" as="geometry"/></mxCell><mxCell id="c_wm1" value="333 提示 + 179 查询" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#222222;" vertex="1" parent="c_w1"><mxGeometry x="10" y="30" width="198" height="20" as="geometry"/></mxCell><mxCell id="c_wr1" value="查询 179–357" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#a33;" vertex="1" parent="c_w1"><mxGeometry x="10" y="52" width="198" height="24" as="geometry"/></mxCell><mxCell id="c_w2" value="" style="rounded=0;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="262" y="370" width="218" height="84" as="geometry"/></mxCell><mxCell id="c_wt2" value="窗口 3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="c_w2"><mxGeometry x="10" y="8" width="198" height="22" as="geometry"/></mxCell><mxCell id="c_wm2" value="333 提示 + 179 查询" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#222222;" vertex="1" parent="c_w2"><mxGeometry x="10" y="30" width="198" height="20" as="geometry"/></mxCell><mxCell id="c_wr2" value="查询 358–399 → 再补 137" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#a33;" vertex="1" parent="c_w2"><mxGeometry x="10" y="52" width="198" height="24" as="geometry"/></mxCell><mxCell id="c_sep" value="" style="rounded=0;html=1;perimeter=rectanglePerimeter;fillColor=#aaaaaa;strokeColor=none;" vertex="1" parent="pc"><mxGeometry x="20" y="488" width="466" height="2" as="geometry"/></mxCell><mxCell id="c_pt" value="第 3 个窗口只有 42 个真实查询细胞，缺的 137 个由源码&#xa;&lt;b&gt;test_indices[:need]&lt;/b&gt; 从查询集开头复制补齐。&#xa;&#xa;⇒ 拼成 400 行提交时，&lt;b&gt;137 / 400 行是重复的&lt;/b&gt;（cr = 0.40）。&#xa;cr = 0.20 时是 162 / 400，cr = 0.25 时是 112 / 400。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#a33;" vertex="1" parent="pc"><mxGeometry x="26" y="506" width="454" height="116" as="geometry"/></mxCell><mxCell id="c_tt" value="提交前的机械后果（notebook 07 实测）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="pc"><mxGeometry x="26" y="642" width="454" height="22" as="geometry"/></mxCell><mxCell id="c_ta0" value="context_ratio" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="pc"><mxGeometry x="26" y="670" width="220" height="36" as="geometry"/></mxCell><mxCell id="c_tb0" value="复制行数 / 400" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="pc"><mxGeometry x="250" y="670" width="230" height="36" as="geometry"/></mxCell><mxCell id="c_ta1" value="0.20" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="26" y="710" width="220" height="36" as="geometry"/></mxCell><mxCell id="c_tb1" value="162" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="250" y="710" width="230" height="36" as="geometry"/></mxCell><mxCell id="c_ta2" value="0.25" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="26" y="750" width="220" height="36" as="geometry"/></mxCell><mxCell id="c_tb2" value="112" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="250" y="750" width="230" height="36" as="geometry"/></mxCell><mxCell id="c_ta3" value="0.40" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="26" y="790" width="220" height="36" as="geometry"/></mxCell><mxCell id="c_tb3" value="137" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="250" y="790" width="230" height="36" as="geometry"/></mxCell><mxCell id="c_warn" value="" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="26" y="854" width="454" height="200" as="geometry"/></mxCell><mxCell id="c_warnt" value="&lt;b&gt;格式检查发现不了这件事。&lt;/b&gt;&#xa;它只看行数、列名、基因顺序、非负整数性——&#xa;不知道第 1 行和第 359 行应是两个生物细胞。&#xa;&#xa;&lt;b&gt;伤害的是群体分布线：&lt;/b&gt;重复行对方差的贡献是 0，&#xa;总 UMI 均值不变，但方差、零比例、状态组成、&#xa;基因间协变全部被拉偏。&#xa;&#xa;&lt;b&gt;工程合同线全绿，分布线已经错了&lt;/b&gt; —— 这才是危险处。&#xa;修法：保留每个查询细胞首次出现的行，按原顺序输出。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#7a2222;" vertex="1" parent="c_warn"><mxGeometry x="20" y="14" width="414" height="172" as="geometry"/></mxCell><mxCell id="c_ns" value="" style="rounded=1;whiteSpace=wrap;html=1;perimeter=rectanglePerimeter;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="pc"><mxGeometry x="26" y="1080" width="454" height="168" as="geometry"/></mxCell><mxCell id="c_nst" value="&lt;b&gt;K 不是结构约束。&lt;/b&gt;&#xa;TabularAttentionLayer.__init__ 收下 n_cells，&#xa;但从不拿它构造任何权重；注意力在 forward 里&#xa;按实际形状 reshape。&#xa;&#xa;所以 K = 256 / 512 只是推理窗口大小，&lt;b&gt;改它不需重训&lt;/b&gt;。&#xa;与 L2-01 §2.4 第 2 项（State 的 cell_set_len）同构。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1f4d13;" vertex="1" parent="c_ns"><mxGeometry x="20" y="14" width="414" height="140" as="geometry"/></mxCell><mxCell id="f_sep" value="" style="rounded=0;html=1;perimeter=rectanglePerimeter;fillColor=#cccccc;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1490" width="1780" height="2" as="geometry"/></mxCell><mxCell id="f_note" value="证据边界：本图全部数字来自固定 commit cacc2e4b 的源码静态核验与 notebook 07 的手算，不是实例化实测。&#xa;显存按张量形状估算，不含 allocator 碎片与 CUDA context；算力只给 FLOPs 量级，耗时未测故不填。&#xa;两处源码与论文的真实差异在本图内标出：窗口切分用 prompt_ratio + context_ratio（panel c），以及 query_pos_embedding 在源码里是 (n, d)。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="1508" width="1780" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>